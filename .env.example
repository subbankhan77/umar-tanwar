# Direct delivery for the contact form. Without these, the form opens the visitor's email app instead.
# SMTP_PASS must be a Google App Password: https://myaccount.google.com/apppasswords
SMTP_USER=umartanwar027@gmail.com
SMTP_PASS=
# Inbox that receives messages (defaults to the email in lib/content.ts)
CONTACT_TO=umartanwar027@gmail.com
# Optional: other SMTP providers (defaults to Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Optional: raises the GitHub API rate limit
GITHUB_TOKEN=
